{
	"name": "@ggml-org/llama-brand",
	"version": "0.1.0",
	"description": "Official brand assets for Llama.app and Llama.cpp: the logo, the fonts and the core CSS",
	"license": "CC-BY-NC-4.0 AND MIT AND OFL-1.1",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ggml-org/llama-brand.git"
	},
	"files": [
		"BRAND-USAGE.md",
		"css/*.css",
		"css/LICENSE",
		"fonts/OFL.txt",
		"fonts/variable/*.ttf",
		"fonts/static/*.ttf",
		"logo/**/*.svg"
	],
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		"./*": "./*"
	},
	"type": "module",
	"scripts": {
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"test:ui": "vitest --project=ui",
		"export:brand-readme": "node scripts/export-brand-readme.mjs",
		"export:design-system": "node scripts/export-design-system.mjs",
		"export:ms-spotlight": "node scripts/export-ms-spotlight.mjs"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "5.5.1",
		"@ggml-org/llama-ui": "0.3.0",
		"@lucide/svelte": "1.46.0",
		"@storybook/addon-a11y": "10.6.2",
		"@storybook/addon-docs": "10.6.2",
		"@storybook/addon-mcp": "10.6.2",
		"@storybook/addon-svelte-csf": "5.1.5",
		"@storybook/addon-vitest": "10.6.2",
		"@storybook/sveltekit": "10.6.2",
		"@sveltejs/kit": "2.70.2",
		"@sveltejs/vite-plugin-svelte": "6.2.1",
		"@tailwindcss/forms": "0.5.10",
		"@tailwindcss/typography": "0.5.20",
		"@tailwindcss/vite": "4.1.11",
		"@types/node": "24.13.0",
		"@vitest/browser": "4.1.12",
		"@vitest/browser-playwright": "4.1.12",
		"mdsvex": "0.12.7",
		"mode-watcher": "1.1.0",
		"modern-screenshot": "4.7.0",
		"playwright": "1.56.1",
		"prettier": "3.8.3",
		"prettier-plugin-svelte": "4.1.0",
		"prettier-plugin-tailwindcss": "0.8.0",
		"storybook": "10.6.2",
		"svelte": "5.56.1",
		"svelte-check": "4.6.0",
		"tailwindcss": "4.3.0",
		"tw-animate-css": "1.4.0",
		"typescript": "5.9.3",
		"vite": "7.3.7",
		"vitest": "4.1.12"
	},
	"overrides": {
		"@storybook/svelte": "10.6.2",
		"svelte": {
			"esrap": "2.2.11"
		}
	}
}
